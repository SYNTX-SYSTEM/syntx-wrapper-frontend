"use client";
import React, { useState, useEffect, useCallback } from 'react';
import { api, statsAPI, StatsResponse, StreamEvent } from '@/lib/api';
import { SYNTX_COLORS } from '@/lib/colorUtils';
import { NeuralBackground } from './effects/NeuralBackground';
import { SynapticConnections } from './effects/SynapticConnections';
import { FloatingModule } from './effects/FloatingModule';
import { NeuralPulseWave } from './charts/NeuralPulseWave';
import { SemanticConstellation } from './charts/SemanticConstellation';
import { EnergyBars } from './charts/EnergyBars';
import { DataMatrixGrid } from './charts/DataMatrixGrid';
import { SyntxLogo } from './effects/SyntxLogo';
import { StromTerminal } from './charts/StromTerminal';
import { motion } from 'framer-motion';
import {
  ResponsiveContainer, RadarChart, Radar, PolarGrid, PolarAngleAxis, Tooltip
} from 'recharts';

function StatOrb({ label, value, icon, color, suffix = '' }: any) {
  return (
        <motion.div
          initial={{ y: -50, opacity: 0 }}
          animate={{ y: 0, opacity: 1 }}
          style={{ marginBottom: 40, textAlign: 'center' }}
        >
          <div style={{ 
            display: 'flex', 
            alignItems: 'center', 
            justifyContent: 'center', 
            gap: 30,
            fontSize: 42, 
            fontWeight: 700,
            fontFamily: 'monospace',
            letterSpacing: '0.1em'
          }}>
            <span style={{
              background: 'linear-gradient(90deg, #00d4ff, #d946ef)',
              WebkitBackgroundClip: 'text',
              WebkitTextFillColor: 'transparent',
              textShadow: '0 0 40px #00d4ff40'
            }}>
              🌊 SYNTX
            </span>
            
            <div style={{ position: 'relative', width: 80, height: 80, flexShrink: 0 }}>
              <SyntxLogo />
            </div>
            
            <span style={{
              background: 'linear-gradient(90deg, #d946ef, #00d4ff)',
              WebkitBackgroundClip: 'text',
              WebkitTextFillColor: 'transparent',
              textShadow: '0 0 40px #d946ef40'
            }}>
              NEURAL FIELD 🌊
            </span>
          </div>
          <p style={{ 
            fontSize: 13, 
            color: 'rgba(255,255,255,0.5)',
            fontFamily: 'monospace',
            marginTop: 10
          }}>
            Real-Time Data Organism • Live Stream Analytics
          </p>
        </motion.div>

        <div style={{ 
          display: 'grid', 
          gridTemplateColumns: 'repeat(5, 1fr)', 
          gap: 20, 
          marginBottom: 40 
        }}>
          <StatOrb 
            label="Total Requests" 
            value={stats?.total_requests || 0} 
            icon="📡" 
            color={SYNTX_COLORS.cyan} 
          />
          <StatOrb 
            label="Success Rate" 
            value={stats?.success_rate || 0} 
            suffix="%" 
            icon="✅" 
            color={SYNTX_COLORS.green} 
          />
          <StatOrb 
            label="Avg Latency" 
            value={((stats?.average_latency_ms || 0) / 1000).toFixed(1)} 
            suffix="s" 
            icon="⚡" 
            color={SYNTX_COLORS.orange} 
          />
          <StatOrb 
            label="Wrappers" 
            value={Object.keys(stats?.wrapper_usage || {}).length} 
            icon="📦" 
            color={SYNTX_COLORS.magenta} 
          />
          <StatOrb 
            label="Events" 
            value={events.length} 
            icon="🌊" 
            color={SYNTX_COLORS.purple} 
          />
        </div>

        <div style={{ 
          display: 'grid', 
          gridTemplateColumns: '2fr 1fr', 
          gap: 24, 
          marginBottom: 24 
        }}>
          <FloatingModule 
            title="⚡ NEURAL PULSE WAVE" 
            glowColor={SYNTX_COLORS.cyan}
            delay={0.1}
            tiltX={2}
          >
            <div style={{ height: 300 }}>
              <NeuralPulseWave data={latencyTimeline} />
            </div>
          </FloatingModule>

          <FloatingModule 
            title="🌀 SEMANTIC CONSTELLATION" 
            glowColor={SYNTX_COLORS.magenta}
            delay={0.2}
            tiltY={-2}
          >
            <div style={{ height: 300 }}>
              <SemanticConstellation data={wrapperPieData} />
            </div>
          </FloatingModule>
        </div>

        <div style={{ 
          display: 'grid', 
          gridTemplateColumns: 'repeat(3, 1fr)', 
          gap: 24, 
          marginBottom: 24 
        }}>
          <FloatingModule 
            title="⚡ ENERGY FLOW BARS" 
            glowColor={SYNTX_COLORS.orange}
            delay={0.3}
          >
            <div style={{ height: 250 }}>
              <EnergyBars data={latencyByWrapper} />
            </div>
          </FloatingModule>

          <FloatingModule 
            title="🎯 WRAPPER PERFORMANCE" 
            glowColor={SYNTX_COLORS.purple}
            delay={0.4}
          >
            <div style={{ height: 250 }}>
              <ResponsiveContainer width="100%" height="100%">
                <RadarChart data={radarData}>
                  <PolarGrid stroke="rgba(255,255,255,0.1)" />
                  <PolarAngleAxis 
                    dataKey="wrapper" 
                    tick={{ fill: 'rgba(255,255,255,0.5)', fontSize: 10 }} 
                  />
                  <Radar 
                    name="Speed" 
                    dataKey="speed" 
                    stroke={SYNTX_COLORS.cyan} 
                    fill={SYNTX_COLORS.cyan} 
                    fillOpacity={0.3} 
                  />
                  <Radar 
                    name="Volume" 
                    dataKey="volume" 
                    stroke={SYNTX_COLORS.magenta} 
                    fill={SYNTX_COLORS.magenta} 
                    fillOpacity={0.3} 
                  />
                  <Tooltip 
                    contentStyle={{ 
                      background: 'rgba(10,26,46,0.98)', 
                      border: '1px solid rgba(0,212,255,0.4)', 
                      borderRadius: 12, 
                      fontFamily: 'monospace' 
                    }} 
                  />
                </RadarChart>
              </ResponsiveContainer>
            </div>
          </FloatingModule>

          <FloatingModule 
            title="📊 RESONANZ KASKADE" 
            glowColor={SYNTX_COLORS.green}
            delay={0.5}
          >
            <div style={{ height: 250, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
              <div style={{ textAlign: 'center', fontFamily: 'monospace', color: 'rgba(255,255,255,0.5)' }}>
                Pipeline Flux
                <br />
                Coming Soon...
              </div>
            </div>
          </FloatingModule>
        </div>

        <div style={{ 
          display: 'grid', 
          gridTemplateColumns: '2fr 1fr', 
          gap: 24 
        }}>
          <FloatingModule 
            title="🗓️ DATA MATRIX GRID" 
            glowColor={SYNTX_COLORS.cyan}
            delay={0.6}
            tiltX={-2}
          >
            <div style={{ height: 250 }}>
              <DataMatrixGrid events={events} />
            </div>
          </FloatingModule>

          <FloatingModule 
            title="📡 STROM TERMINAL" 
            glowColor={SYNTX_COLORS.green}
            delay={0.7}
            tiltY={2}
          >
            <StromTerminal events={events} />
          </FloatingModule>
        </div>
      </div>
    </div>
  );
}
